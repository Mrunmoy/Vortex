      "opacity": 100, "groupIds": [], "frameId": null, "index": "a4a", "roundness": null,
      "seed": 5003, "version": 1, "versionNonce": 5004, "isDeleted": false,
      "boundElements": null, "updated": 1774700000000, "link": null, "locked": false,
      "text": "addTimer(intervalMs, repeating, handler)\n\nOne-shot or repeating. Handler on loop thread.\nLinux: timerfd  |  macOS: EVFILT_TIMER  |  Win32: WaitableTimer\n\nm_timers: map<TimerId, {interval, repeating, handler}>",
      "originalText": "addTimer(intervalMs, repeating, handler)\n\nOne-shot or repeating. Handler on loop thread.\nLinux: timerfd  |  macOS: EVFILT_TIMER  |  Win32: WaitableTimer\n\nm_timers: map<TimerId, {interval, repeating, handler}>",
      "autoResize": true, "fontSize": 11, "fontFamily": 2, "textAlign": "left",
      "verticalAlign": "middle", "containerId": "timers_box", "lineHeight": 1.25
    },

