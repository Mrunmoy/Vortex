    {
      "id": "t_safety", "type": "text", "x": 45, "y": 678, "width": 850, "height": 45,
      "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "frameId": null, "index": "aCa", "roundness": null,
      "seed": 13003, "version": 1, "versionNonce": 13004, "isDeleted": false,
      "boundElements": null, "updated": 1774700000000, "link": null, "locked": false,
      "text": "Thread safety: run() blocks on one thread. All handlers fire on that thread (no concurrency between handlers).\nexecuteOnRunLoop(), addSource(), removeSource(), addTimer(), removeTimer(), stop() — all callable from ANY thread.\nPost queue uses mutex + swap-drain. Sources/timers use m_sourcesMutex / m_timersMutex.",
      "originalText": "Thread safety: run() blocks on one thread. All handlers fire on that thread (no concurrency between handlers).\nexecuteOnRunLoop(), addSource(), removeSource(), addTimer(), removeTimer(), stop() — all callable from ANY thread.\nPost queue uses mutex + swap-drain. Sources/timers use m_sourcesMutex / m_timersMutex.",
      "autoResize": true, "fontSize": 11, "fontFamily": 2, "textAlign": "left",
      "verticalAlign": "middle", "containerId": "thread_safety", "lineHeight": 1.25
    }
  ],
