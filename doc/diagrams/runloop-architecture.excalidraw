      "seed": 3003, "version": 1, "versionNonce": 3004, "isDeleted": false,
      "boundElements": null, "updated": 1774700000000, "link": null, "locked": false,
      "text": "run() — main loop\n1. Drain posted callables\n2. Block in OS poll (epoll_wait / kevent / WFMO)\n3. Dispatch fired sources and timers",
      "originalText": "run() — main loop\n1. Drain posted callables\n2. Block in OS poll (epoll_wait / kevent / WFMO)\n3. Dispatch fired sources and timers",
      "autoResize": true, "fontSize": 12, "fontFamily": 2, "textAlign": "left",
      "verticalAlign": "middle", "containerId": "poll_box", "lineHeight": 1.25
    },

