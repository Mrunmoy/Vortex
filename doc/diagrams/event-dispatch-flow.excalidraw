      "seed": 6003, "version": 1, "versionNonce": 6004, "isDeleted": false,
      "boundElements": null, "updated": 1774700000000, "link": null, "locked": false,
      "text": "3. BLOCK in OS poll\n   Linux:   epoll_wait(m_pollFd, ...)\n   macOS:   kevent(m_pollFd, ...)\n   Win32:   WaitForMultipleObjects(...)\n   Thread sleeps here until event",
      "originalText": "3. BLOCK in OS poll\n   Linux:   epoll_wait(m_pollFd, ...)\n   macOS:   kevent(m_pollFd, ...)\n   Win32:   WaitForMultipleObjects(...)\n   Thread sleeps here until event",
      "autoResize": true, "fontSize": 11, "fontFamily": 3, "textAlign": "left",
      "verticalAlign": "middle", "containerId": "s3", "lineHeight": 1.25
    },

