    {
      "id": "t4", "type": "text", "x": 65, "y": 428, "width": 290, "height": 85,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "frameId": null, "index": "a7a", "roundness": null,
      "seed": 8003, "version": 1, "versionNonce": 8004, "isDeleted": false,
      "boundElements": null, "updated": 1774700000000, "link": null, "locked": false,
      "text": "4. Dispatch signaled event\n   Wakeup pipe → loop back to step 1\n   Source fd ready → call handler()\n   Timer fired → call handler()\n     one-shot: auto-remove\n     repeating: re-arm\n   Source error → call onError() + remove",
      "originalText": "4. Dispatch signaled event\n   Wakeup pipe → loop back to step 1\n   Source fd ready → call handler()\n   Timer fired → call handler()\n     one-shot: auto-remove\n     repeating: re-arm\n   Source error → call onError() + remove",
      "autoResize": true, "fontSize": 11, "fontFamily": 2, "textAlign": "left",
      "verticalAlign": "middle", "containerId": "s4", "lineHeight": 1.25
    },

